{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/index.ts"]
    },
    "examples/*": {
      "entry": ["src/readmeSnippet.tsx"]
    },
    "apps/*": {
      "entry": ["src/main.tsx", "src/mobile/main.js", "scripts/chunks.ts"]
    }
  },
  "ignoreDependencies": ["@saystack/react"],
  "exclude": ["unresolved", "duplicates", "types"]
}
