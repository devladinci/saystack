{
  "name": "@saystack/react",
  "version": "0.2.0",
  "description": "React hooks for voice chat on any platform: dictation and read-aloud sessions with coded errors.",
  "license": "MIT",
  "author": "DeVladinci",
  "homepage": "https://github.com/devladinci/saystack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devladinci/saystack.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/devladinci/saystack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@saystack/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@saystack/engine-openai-compatible": "workspace:*",
    "@saystack/server": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "keywords": [
    "stt",
    "voice",
    "dictation",
    "react",
    "speech",
    "tts",
    "read-aloud"
  ],
  "publishConfig": {
    "access": "public"
  }
}
