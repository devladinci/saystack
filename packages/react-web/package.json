{
  "name": "@saystack/react-web",
  "version": "0.3.0",
  "description": "React voice UI for the web: spectral aura, read-along, streaming dictation and a read-aloud player.",
  "license": "MIT",
  "author": "DeVladinci",
  "homepage": "https://github.com/devladinci/saystack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devladinci/saystack.git",
    "directory": "packages/react-web"
  },
  "bugs": {
    "url": "https://github.com/devladinci/saystack/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@saystack/core": "workspace:*",
    "@saystack/react": "workspace:*",
    "@saystack/web": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "keywords": [
    "voice",
    "react",
    "speech",
    "tts",
    "stt",
    "read-along",
    "visualizer"
  ],
  "publishConfig": {
    "access": "public"
  }
}
